# ==============================================================================
# OpenAlgo Environment Variable Reference (.env.example)
# Use this configuration in Coolify, Dokploy, Railway, or Docker Compose
# ==============================================================================

# Required: Server Base URL & Broker Redirect Callback
HOST_SERVER=https://openalgo.yourdomain.com
REDIRECT_URL=https://openalgo.yourdomain.com/broker/callback

# Required: Secret Keys (64-char hex strings)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Note: Container will auto-generate if left empty
APP_KEY=
API_KEY_PEPPER=

# Broker Credentials
BROKER_API_KEY=your_broker_api_key
BROKER_API_SECRET=your_broker_api_secret

# Optional Market Data Keys (Required for XTS brokers)
BROKER_API_KEY_MARKET=
BROKER_API_SECRET_MARKET=

# Optional Network Ports & Environment Settings
PORT=5000
WEBSOCKET_PORT=8765
FLASK_ENV=production
LOG_LEVEL=INFO
