# OpenAlgo Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - These must be set for the application to work
# =============================================================================

# Your application URL (no trailing slash)
HOST_SERVER=https://openalgo.example.com

# OAuth callback URL for your broker
REDIRECT_URL=https://openalgo.example.com/broker/callback

# Broker API credentials
BROKER_API_KEY=your_broker_api_key
BROKER_API_SECRET=your_broker_api_secret

# Security keys - generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_KEY=generate_a_64_char_hex_string_here
API_KEY_PEPPER=generate_another_64_char_hex_string_here

# =============================================================================
# OPTIONAL - These have sensible defaults
# =============================================================================

# Server configuration
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=0
APP_MODE=standalone
LOG_LEVEL=INFO

# WebSocket configuration
WEBSOCKET_PORT=8765
# WEBSOCKET_URL=wss://openalgo.example.com/ws  # Auto-detected from HOST_SERVER

# Database (defaults to SQLite)
# DATABASE_URL=sqlite:///db/openalgo.db

# =============================================================================
# XTS BROKER ONLY - Required for XTS-based brokers
# =============================================================================

# BROKER_API_KEY_MARKET=your_market_data_api_key
# BROKER_API_SECRET_MARKET=your_market_data_api_secret
